---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="pagehead">
    <div class="wrap">
      <span class="label on-blue">404</span>
      <h1>That page isn't on the record.</h1>
      <p class="lede">The address may be mistyped, or the page may have moved.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <p><a href="/">Go to the home page</a> or <a href="/records/">browse all records</a>.</p>
    </div>
  </section>
</Base>
