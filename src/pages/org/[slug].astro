---
import Base from '../../layouts/Base.astro';
import RecordCard from '../../components/RecordCard.astro';
import StartNote from '../../components/StartNote.astro';
import Criteria from '../../components/Criteria.astro';
import { FORMAT, KIND, ROLE_TO, ROLE_FROM, ROLE_ORDER } from '../../lib/formats';
import { SITE } from '../../site.config';
import { loadAll, fmtDate } from '../../lib/records';

export async function getStaticPaths() {
  const { orgs } = await loadAll();
  return orgs.map((o) => ({ params: { slug: o.id }, props: { id: o.id } }));
}
const { recs, orgs } = await loadAll();
const o = orgs.find((x) => x.id === Astro.props.id)!;
const d = o.data;
const all = recs.filter((r) => r.counterparty?.id === o.id);
const list = all.filter((r) => !r.earlier);
const businesses = [...new Map(all.flatMap((r) => r.businesses).map((b) => [b.id, b])).values()].sort((a, b) => a.data.name.localeCompare(b.data.name));
const rounds = [...d.rounds].reverse(); // newest first
const inRound = (slug: string) => all.filter((r) => r.d.round === slug);
const url = new URL(`/org/${o.id}/`, SITE.url).href;
const c = d.criteria;
// An organization that only appears in another's lineage: no rounds, no records. Its page shows the connections, not empty record lists.
const linkOnly = rounds.length === 0 && all.length === 0;
const byId = new Map(orgs.map((x) => [x.id, x]));
// This organization's own lineage, then everything that names it in theirs.
const up = ROLE_ORDER.map((role) => ({ role, items: d.connections.filter((k) => k.role === role).map((k) => ({ org: byId.get(k.org.id)!, note: k.note })) })).filter((g) => g.items.length);
const down = ROLE_ORDER.map((role) => ({ role, items: orgs.flatMap((x) => x.data.connections.filter((k) => k.org.id === o.id && k.role === role).map((k) => ({ org: x, note: k.note }))) })).filter((g) => g.items.length);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url,
  mainEntity: {
    '@type': 'Organization',
    name: d.name,
    url: d.website,
    description: d.summary,
    subjectOf: [
      ...(c ? [{ '@type': 'DigitalDocument', name: c.source_label, url: c.source_url, dateCreated: c.source_date }] : []),
      ...d.rounds.filter((rd) => rd.criteria).map((rd) => ({ '@type': 'DigitalDocument', name: rd.criteria!.source_label, url: rd.criteria!.source_url })),
      ...list.map((r) => new URL(r.url, SITE.url).href),
    ],
    ...(up.find((g) => g.role === 'funds') ? { funder: up.find((g) => g.role === 'funds')!.items.map((it) => ({ '@type': 'Organization', name: it.org.data.name, url: new URL(`/org/${it.org.id}/`, SITE.url).href })) } : {}),
    ...(up.find((g) => g.role === 'affiliate') ? { parentOrganization: up.find((g) => g.role === 'affiliate')!.items.map((it) => ({ '@type': 'Organization', name: it.org.data.name })) } : {}),
  },
};
---
<Base title={d.name} description={d.summary ?? `${d.name}: its documented involvement with Detroit founders and businesses.`} jsonld={jsonld}>
  <section class="pagehead">
    <div class="wrap">
      <span class="label on-blue">{KIND[d.kind]}{d.example && ' · Example, fictional'}</span>
      <h1>{d.name}</h1>
      <p class="lede">{d.summary ?? "A sourced history of this organization's involvement with Detroit founders and businesses."}</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      {linkOnly ? (d.website && <p class="count"><a href={d.website} rel="noopener">Official page</a></p>) : (
        <p class="count">{list.length} {list.length === 1 ? 'record' : 'records'} · {businesses.length} {businesses.length === 1 ? 'business' : 'businesses'}
          {d.website && <> · <a href={d.website} rel="noopener">Official page</a></>}</p>
      )}
      {(up.length > 0 || down.length > 0) && (
        <div class="lineage">
          <h2 class="sec">How it's connected</h2>
          <dl>
            {up.map((g) => <><dt>{ROLE_TO[g.role]}</dt>{g.items.map((it) => <dd><a href={`/org/${it.org.id}/`}>{it.org.data.name}</a>{it.note && <span class="ln-note"> · {it.note}</span>}</dd>)}</>)}
            {down.map((g) => <><dt>{ROLE_FROM[g.role]}</dt>{g.items.map((it) => <dd><a href={`/org/${it.org.id}/`}>{it.org.data.name}</a>{it.note && <span class="ln-note"> · {it.note}</span>}</dd>)}</>)}
          </dl>
        </div>
      )}
      {d.run_by.length > 0 && <p class="runby">Also involved: {d.run_by.join(', ')}.</p>}

      {c && <Criteria c={c} />}

      {rounds.length > 0 && (
        <>
          <h2 class="sec">What {d.name} runs</h2>
          <ul class="rounds">
            {rounds.map((rd) => {
              const n = inRound(rd.slug).length;
              return (
                <li>
                  <a class="round-name" href={`/org/${o.id}/${rd.slug}/`}>{rd.label}</a>
                  {rd.format && <span class="fmt">{FORMAT[rd.format]}</span>}
                  <span class="round-meta">
                    {rd.opens && rd.closes && <>Applications {fmtDate(rd.opens)} to {fmtDate(rd.closes)}</>}
                    {!rd.opens && rd.closes && <>Applications closed {fmtDate(rd.closes)}</>}
                    {rd.finalists_announced && !rd.announced && <> · Finalists expected {fmtDate(rd.finalists_announced)}</>}
                    {rd.event && <> · {(rd.event_label ?? 'Event') + ' ' + fmtDate(rd.event)}</>}
                    {rd.announced && <> · Announced {fmtDate(rd.announced)}</>}
                  </span>
                  <span class="mono">{n} {n === 1 ? 'record' : 'records'}</span>
                </li>
              );
            })}
          </ul>
        </>
      )}

      {!linkOnly && <h2 class="sec">Records</h2>}
      {!linkOnly && (list.length ? <div class="cards">{list.map((r) => <RecordCard r={r} />)}</div> : <p class="empty">No records yet. The Detroit Innovation Record began on {fmtDate(new Date(SITE.recordStart))}.</p>)}
      {businesses.length > 0 && (
        <>
          <h2 class="sec">Businesses named with {d.name}</h2>
          <ul class="orglist">{businesses.map((b) => <li><a href={`/business/${b.id}/`}>{b.data.name}</a></li>)}</ul>
        </>
      )}
      {!linkOnly && <StartNote />}
    </div>
  </section>
</Base>

<style is:global>
/* Program pages: criteria and rounds */
.runby { color: var(--muted); margin-top: 6px; }
.criteria { background: var(--surface); border: 1px solid var(--line); border-left: 6px solid var(--yellow); border-radius: 10px; padding: 22px 24px; margin: 28px 0; }
.criteria .sec { margin-top: 0; }
.crit-src { margin: 8px 0 14px; }
.crit-list { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 10px 22px; margin: 0; }
.crit-list dt { font-weight: 600; color: var(--muted); }
.crit-list dd { margin: 0; }
.crit-list ul { margin: 0; padding-left: 18px; }
.crit-list li + li { margin-top: 4px; }
.crit-note { color: var(--muted); font-size: 15px; margin-top: 14px; }
.crit-dates { font-size: 13px; color: var(--muted); margin-top: 12px; }
.rounds { list-style: none; padding: 0; margin: 12px 0 28px; border-top: 1px solid var(--line); }
.rounds li { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
.round-name { font-family: var(--display); font-weight: 700; font-size: 20px; min-width: 110px; }
.round-meta { color: var(--muted); flex: 1; }
.fmt { font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--blue); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; }
.round-facts { margin-bottom: 8px; }
.crumb-on-blue { color: inherit; }
@media (max-width: 640px) { .crit-list { grid-template-columns: 1fr; gap: 2px; } .crit-list dd { margin-bottom: 10px; } }
.lineage dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 20px; margin: 0 0 24px; }
.lineage dt { font-weight: 600; color: var(--muted); grid-column: 1; }
.lineage dd { margin: 0; grid-column: 2; }
.ln-note { color: var(--muted); }
@media (max-width: 640px) { .lineage dl { grid-template-columns: 1fr; } .lineage dt, .lineage dd { grid-column: 1; } .lineage dt { margin-top: 10px; } }
</style>
