---
import { SITE } from '../site.config';
interface Props { title?: string; description?: string; jsonld?: object | object[]; canonical?: string }
const { title, description = SITE.description, jsonld, canonical } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: Detroit's innovation, on the record`;
const canon = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const here = (p: string) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canon} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canon} />
  <link rel="alternate" type="application/json" href="/records.json" title="All records (JSON)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/styles.css" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="mast">
    <div class="wrap">
      <a class="brand" href="/"><b>{SITE.short}</b><span>{SITE.name}</span></a>
      <nav aria-label="Main">
        <a href="/records/" aria-current={here('/records/')}>Browse records</a>
        <a href="/organizations/" aria-current={here('/organizations/')}>Organizations</a>
        <a href="/about/" aria-current={here('/about/')}>How it works</a>
        <a href="/about/#contact">Contact</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="wrap">
      <span>The {SITE.name} is run by the <a href={SITE.publisherUrl}><b>{SITE.publisher}</b></a>, founded by {SITE.founder}.</span>
      <span class="foot-links"><a href="/about/#rules">Our rules</a><a href="/about/#contacted">If we contacted you</a><a href="/records.json">Data (JSON)</a></span>
    </div>
  </footer>
</body>
</html>
